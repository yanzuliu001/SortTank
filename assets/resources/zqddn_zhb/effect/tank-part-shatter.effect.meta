      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec2 a_uv0;\nattribute vec4 a_color;\nvarying vec2 v_uv0;\nvarying float v_alpha;\nvarying float v_light;\nuniform vec4 motion;\nuniform vec4 targetData;\nuniform vec4 spriteData;\nfloat hash11(float value) {\n  return fract(sin(value * 91.3458 + 17.234) * 47453.5453);\n}\nvoid main () {\n  float progress = clamp(motion.x, 0.0, 1.0);\n  float eased = progress * progress * (3.0 - 2.0 * progress);\n  vec2 center = (a_color.rg - vec2(0.5)) * spriteData.xy;\n  vec2 target = targetData.xy;\n  vec2 delta = target - center;\n  float distanceToTarget = max(length(delta), 0.0001);\n  vec2 direction = delta / distanceToTarget;\n  vec2 normal = vec2(-direction.y, direction.x);\n  float seed = a_color.b + 0.017;\n  float curveSide = a_color.a * 2.0 - 1.0;\n  float curveAmount = motion.y * mix(0.65, 1.05, hash11(seed * 5.17)) * curveSide;\n  vec2 control = mix(center, target, 0.45) + normal * curveAmount;\n  float inverse = 1.0 - eased;\n  vec2 currentCenter = inverse * inverse * center\n    + 2.0 * inverse * eased * control\n    + eased * eased * target;\n  vec2 radial = center;\n  float radialLen = max(length(radial), 0.0001);\n  vec2 radialDir = radial / radialLen;\n  float burst = sin(min(progress, 0.22) / 0.22 * 3.1415926) * (1.0 - smoothstep(0.14, 0.55, progress));\n  currentCenter += radialDir * motion.y * mix(0.08, 0.18, hash11(seed * 11.7)) * burst;\n  float angle = (hash11(seed * 17.31) * 2.0 - 1.0) * motion.z * (0.35 + 0.65 * eased);\n  float sine = sin(angle);\n  float cosine = cos(angle);\n  mat2 rotation = mat2(cosine, -sine, sine, cosine);\n  float shrink = smoothstep(motion.w, 1.0, eased);\n  float flip = sin(progress * 9.424778 + seed * 6.2831853);\n  float perspective = mix(1.0, 0.58, abs(flip) * (1.0 - shrink * 0.65));\n  float scale = mix(1.0, targetData.z, shrink);\n  vec2 localPosition = rotation * (a_position.xy - center) * scale;\n  localPosition.y *= perspective;\n  vec4 position = vec4(currentCenter + localPosition, a_position.z, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_uv0 = a_uv0;\n  v_alpha = 1.0 - smoothstep(targetData.w, 1.0, eased);\n  v_light = mix(0.68, 1.28, 0.5 + 0.5 * flip) * mix(0.9, 1.15, hash11(seed * 29.1));\n}",
        "frag": "\nprecision mediump float;\nvarying vec2 v_uv0;\nvarying float v_alpha;\nvarying float v_light;\n#if USE_TEXTURE\nuniform sampler2D texture;\n#endif\nvoid main () {\n  vec4 color = vec4(1.0);\n  #if USE_TEXTURE\n  vec4 texture_tmp = texture2D(texture, v_uv0);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, v_uv0 + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    color.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    color.a *= texture_tmp.a;\n  #else\n    color *= texture_tmp;\n  #endif\n  #endif\n  color.rgb *= v_light;\n  color.rgb += vec3(0.08, 0.1, 0.12) * max(0.0, v_light - 1.0);\n  color.a *= v_alpha;\n  if (color.a <= 0.001) {\n    discard;\n  }\n  #if USE_BGRA\n    gl_FragColor = color.bgra;\n  #else\n    gl_FragColor = color.rgba;\n  #endif\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec2 a_uv0;\nin vec4 a_color;\nout vec2 v_uv0;\nout float v_alpha;\nout float v_light;\nuniform Shatter {\n  vec4 motion;\n  vec4 targetData;\n  vec4 spriteData;\n};\nfloat hash11(float value) {\n  return fract(sin(value * 91.3458 + 17.234) * 47453.5453);\n}\nvoid main () {\n  float progress = clamp(motion.x, 0.0, 1.0);\n  float eased = progress * progress * (3.0 - 2.0 * progress);\n  vec2 center = (a_color.rg - vec2(0.5)) * spriteData.xy;\n  vec2 target = targetData.xy;\n  vec2 delta = target - center;\n  float distanceToTarget = max(length(delta), 0.0001);\n  vec2 direction = delta / distanceToTarget;\n  vec2 normal = vec2(-direction.y, direction.x);\n  float seed = a_color.b + 0.017;\n  float curveSide = a_color.a * 2.0 - 1.0;\n  float curveAmount = motion.y * mix(0.65, 1.05, hash11(seed * 5.17)) * curveSide;\n  vec2 control = mix(center, target, 0.45) + normal * curveAmount;\n  float inverse = 1.0 - eased;\n  vec2 currentCenter = inverse * inverse * center\n    + 2.0 * inverse * eased * control\n    + eased * eased * target;\n  vec2 radial = center;\n  float radialLen = max(length(radial), 0.0001);\n  vec2 radialDir = radial / radialLen;\n  float burst = sin(min(progress, 0.22) / 0.22 * 3.1415926) * (1.0 - smoothstep(0.14, 0.55, progress));\n  currentCenter += radialDir * motion.y * mix(0.08, 0.18, hash11(seed * 11.7)) * burst;\n  float angle = (hash11(seed * 17.31) * 2.0 - 1.0) * motion.z * (0.35 + 0.65 * eased);\n  float sine = sin(angle);\n  float cosine = cos(angle);\n  mat2 rotation = mat2(cosine, -sine, sine, cosine);\n  float shrink = smoothstep(motion.w, 1.0, eased);\n  float flip = sin(progress * 9.424778 + seed * 6.2831853);\n  float perspective = mix(1.0, 0.58, abs(flip) * (1.0 - shrink * 0.65));\n  float scale = mix(1.0, targetData.z, shrink);\n  vec2 localPosition = rotation * (a_position.xy - center) * scale;\n  localPosition.y *= perspective;\n  vec4 position = vec4(currentCenter + localPosition, a_position.z, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matViewProj * cc_matWorld * position;\n  #else\n    position = cc_matViewProj * position;\n  #endif\n  gl_Position = position;\n  v_uv0 = a_uv0;\n  v_alpha = 1.0 - smoothstep(targetData.w, 1.0, eased);\n  v_light = mix(0.68, 1.28, 0.5 + 0.5 * flip) * mix(0.9, 1.15, hash11(seed * 29.1));\n}",
        "frag": "\nprecision mediump float;\nin vec2 v_uv0;\nin float v_alpha;\nin float v_light;\n#if USE_TEXTURE\nuniform sampler2D texture;\n#endif\nvoid main () {\n  vec4 color = vec4(1.0);\n  #if USE_TEXTURE\n  vec4 texture_tmp = texture(texture, v_uv0);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture(texture, v_uv0 + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    color.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    color.a *= texture_tmp.a;\n  #else\n    color *= texture_tmp;\n  #endif\n  #endif\n  color.rgb *= v_light;\n  color.rgb += vec3(0.08, 0.1, 0.12) * max(0.0, v_light - 1.0);\n  color.a *= v_alpha;\n  if (color.a <= 0.001) {\n    discard;\n  }\n  #if USE_BGRA\n    gl_FragColor = color.bgra;\n  #else\n    gl_FragColor = color.rgba;\n  #endif\n}"
