CCEffect %{
  techniques:
    - passes:
        - blendState:
            targets:
              - blend: true
          rasterizerState:
            cullMode: 0
          properties:
            texture:
              value: "white"
            motion:
              value:
                - 0
                - 36
                - 4.712389
                - 0.75
            targetData:
              value:
                - 0
                - 0
                - 0.2
                - 0.9
            spriteData:
              value:
                - 1
                - 1
                - 0
                - 0
          vert: "vs"
          frag: "fs"
}%

CCProgram vs %{
precision highp float;
#include <cc-global>
#include <cc-local>

in vec3 a_position;
in vec2 a_uv0;
in vec4 a_color;
out vec2 v_uv0;
out float v_alpha;
out float v_light;

uniform Shatter {
  vec4 motion;
  vec4 targetData;
  vec4 spriteData;
};

float hash11(float value) {
  return fract(sin(value * 91.3458 + 17.234) * 47453.5453);
}

void main () {
  float progress = clamp(motion.x, 0.0, 1.0);
  float eased = progress * progress * (3.0 - 2.0 * progress);
  vec2 center = (a_color.rg - vec2(0.5)) * spriteData.xy;
  vec2 target = targetData.xy;
  vec2 delta = target - center;
  float distanceToTarget = max(length(delta), 0.0001);
  vec2 direction = delta / distanceToTarget;
  vec2 normal = vec2(-direction.y, direction.x);
  float seed = a_color.b + 0.017;
  float curveSide = a_color.a * 2.0 - 1.0;
  float curveAmount = motion.y * mix(0.65, 1.05, hash11(seed * 5.17)) * curveSide;
  vec2 control = mix(center, target, 0.45) + normal * curveAmount;
  float inverse = 1.0 - eased;
  vec2 currentCenter = inverse * inverse * center
    + 2.0 * inverse * eased * control
    + eased * eased * target;
  vec2 radial = center;
  float radialLen = max(length(radial), 0.0001);
  vec2 radialDir = radial / radialLen;
  float burst = sin(min(progress, 0.22) / 0.22 * 3.1415926) * (1.0 - smoothstep(0.14, 0.55, progress));
  currentCenter += radialDir * motion.y * mix(0.08, 0.18, hash11(seed * 11.7)) * burst;
  float angle = (hash11(seed * 17.31) * 2.0 - 1.0) * motion.z * (0.35 + 0.65 * eased);
  float sine = sin(angle);
  float cosine = cos(angle);
  mat2 rotation = mat2(cosine, -sine, sine, cosine);
  float shrink = smoothstep(motion.w, 1.0, eased);
  float flip = sin(progress * 9.424778 + seed * 6.2831853);
  float perspective = mix(1.0, 0.58, abs(flip) * (1.0 - shrink * 0.65));
  float scale = mix(1.0, targetData.z, shrink);
  vec2 localPosition = rotation * (a_position.xy - center) * scale;
  localPosition.y *= perspective;
  vec4 position = vec4(currentCenter + localPosition, a_position.z, 1.0);
  #if CC_USE_MODEL
    position = cc_matViewProj * cc_matWorld * position;
  #else
    position = cc_matViewProj * position;
  #endif
  gl_Position = position;
  v_uv0 = a_uv0;
  v_alpha = 1.0 - smoothstep(targetData.w, 1.0, eased);
  v_light = mix(0.68, 1.28, 0.5 + 0.5 * flip) * mix(0.9, 1.15, hash11(seed * 29.1));
}
}%

CCProgram fs %{
precision mediump float;

#include <texture>

in vec2 v_uv0;
in float v_alpha;
in float v_light;
#if USE_TEXTURE
uniform sampler2D texture;
#endif

void main () {
  vec4 color = vec4(1.0);
  #if USE_TEXTURE
    CCTexture(texture, v_uv0, color);
  #endif
  color.rgb *= v_light;
  color.rgb += vec3(0.08, 0.1, 0.12) * max(0.0, v_light - 1.0);
  color.a *= v_alpha;
  if (color.a <= 0.001) {
    discard;
  }
  #if USE_BGRA
    gl_FragColor = color.bgra;
  #else
    gl_FragColor = color.rgba;
  #endif
}
}%
